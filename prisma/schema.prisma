// FreshBhoj - Prisma Schema
// PostgreSQL + Full Relational Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING_PROFILE
  DELETED
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  RESET
  ACCOUNT_DELETION
}

enum CoinTransactionReason {
  REFERRAL_REFERRER_BONUS
  REFERRAL_REFEREE_BONUS
  ORDER_REDEMPTION
  SUBSCRIPTION_REDEMPTION
  /// Coins spent on an order that was then cancelled — handed back.
  ORDER_REFUND
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  phone           String     @unique
  fullName        String?
  email           String?    @unique
  profileImage    String? // S3/CDN URL
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING_PROFILE)
  isPhoneVerified Boolean    @default(false)

  // Location (last known)
  latitude  Float?
  longitude Float?
  address   String?
  city      String?
  state     String?
  pincode   String?

  // Metadata
  fcmToken            String? // Firebase push token
  lastLoginAt         DateTime?
  /// Notification inbox read marker — anything newer than this is "unread".
  notificationsReadAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Referral / FreshBhoj Coins
  referralCode     String?           @unique // Every user gets one at signup, shared to invite others
  coinsBalance     Int               @default(0) // FreshBhoj Coins
  referredById     String? // Set once, the first time this user redeems someone else's code
  referredBy       User?             @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]            @relation("Referrals")
  coinTransactions CoinTransaction[]

  // Relations
  refreshTokens RefreshToken[]
  otpLogs       OtpLog[]

  // Commerce relations
  addresses              Address[]
  cart                   Cart?
  orders                 Order[]
  reviews                Review[]
  reviewHelpfulVotes     ReviewHelpfulVote[]
  favorites              Favorite[]
  kitchenFollows         KitchenFollow[]
  reelLikes              ReelLike[]
  reelSaves              ReelSave[]
  savedCards             SavedCard[]
  upiIds                 UpiId[]
  storyViews             KitchenStoryView[]
  storyLikes             KitchenStoryLike[]
  ownedKitchens          Kitchen[]               @relation("KitchenOwner")
  notificationPreference NotificationPreference?
  subscriptions          Subscription[]
  wallet                 CustomerWallet?

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERRALS / FRESHBHOJ COINS
// ─────────────────────────────────────────────────────────────────────────────

model CoinTransaction {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // Positive for earnings, negative for order redemptions
  reason    CoinTransactionReason
  createdAt DateTime              @default(now())

  @@index([userId])
  @@map("coin_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// WEBSITE PRE-REGISTRATION (WAITLIST)
// ─────────────────────────────────────────────────────────────────────────────

model WebUserPreRegistration {
  id          String  @id @default(uuid())
  role        String  @default("USER") // For web context, always 'USER' here
  fullName    String
  mobileNo    String // Can't unique constraint globally if they try multiple times, but let's make it unique relative to waitlist
  email       String?
  state       String?
  city        String?
  areaPincode String?

  aboutYourself String? // 'STUDENT', 'PROFESSIONAL', 'FAMILY', 'OTHER'
  taste         String? // 'VEG', 'NON_VEG', 'BOTH'
  lookingFor    String? // 'DAILY_TIFFIN', 'OCCASIONAL', 'STREET_FOOD', 'HOME_STYLE'

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("web_user_preregistration")
}

model WebKitchenPreRegistration {
  id            String  @id @default(uuid())
  kitchenName   String
  contactPerson String
  mobileNo      String
  email         String?

  vendorType   String? // 'CLOUD_KITCHEN', 'TIFFIN_SERVICE', 'STREET_FOOD', 'RESTAURANT'
  avgMealPrice String? // '50-100', '100-200', '200-350', '350+'

  state String?
  city  String?

  fssaiStatus    String? // 'REGISTERED', 'APPLIED'
  fssaiLicenseNo String?
  gstNumber      String?

  deliveryCapability String? // 'SELF', 'FRESHBHOJ'
  serviceTiming      String[] // e.g. ['BREAKFAST', 'LUNCH', 'DINNER']

  interestedInReels Boolean @default(false)
  whyJoinFreshbhoj  String?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("web_kitchen_preregistration")
}

// ─────────────────────────────────────────────────────────────────────────────
// OTP LOG
// ─────────────────────────────────────────────────────────────────────────────

model OtpLog {
  id          String     @id @default(uuid())
  phone       String
  otp         String // Hashed
  purpose     OtpPurpose @default(LOGIN)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  isUsed      Boolean    @default(false)
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  // Optional: link to user if already exists
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, isUsed])
  @@map("otp_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique // Hashed
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String? // e.g. "iPhone 15 / iOS 17"
  ipAddress  String?
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ═════════════════════════════════════════════════════════════════════════════
// COMMERCE DOMAIN — Kitchens, Meals, Cart, Orders, Reviews, Reels
// ═════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum KitchenStatus {
  PENDING
  ACTIVE
  PAUSED
  SUSPENDED
}

/// Broad meal slot a dish belongs to. Drives the Home "Meal categories" grid.
enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

/// Indian food-app veg/non-veg convention. Drives the coloured dot indicator.
enum FoodType {
  VEG
  EGG
  NON_VEG
  VEGAN
}

/// Goal-based quick filters on Home. Core to the FreshBhoj nutrition promise.
enum GoalTag {
  HIGH_PROTEIN
  LOW_CALORIE
  WEIGHT_LOSS
  MUSCLE_GAIN
  HEALTHY_LIFESTYLE
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum DeliverySlotType {
  NOW
  SCHEDULED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CouponType {
  FLAT
  PERCENT
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICEABILITY — single-city launch (Jaipur)
// ─────────────────────────────────────────────────────────────────────────────

model ServiceableArea {
  id        String   @id @default(uuid())
  city      String
  state     String   @default("Rajasthan")
  locality  String
  pincode   String
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([city, locality])
  @@index([pincode])
  @@index([isActive, city])
  @@map("serviceable_areas")
}

// ─────────────────────────────────────────────────────────────────────────────
// KITCHEN
// ─────────────────────────────────────────────────────────────────────────────

model Kitchen {
  id          String        @id @default(uuid())
  slug        String        @unique
  name        String
  tagline     String?
  description String?
  logoUrl     String?
  coverImage  String?
  isVerified  Boolean       @default(false)
  status      KitchenStatus @default(ACTIVE)

  // Trust / quality signals
  fssaiLicense  String?
  hygieneScore  Float?
  rating        Float   @default(0)
  ratingCount   Int     @default(0)
  followerCount Int     @default(0)

  // Location
  addressLine     String?
  locality        String?
  city            String  @default("Jaipur")
  state           String  @default("Rajasthan")
  pincode         String?
  latitude        Float?
  longitude       Float?
  /// How far this kitchen is willing to deliver, set during onboarding.
  serviceRadiusKm Float?

  /// Business format, chosen during onboarding — nullable until the partner picks one.
  kitchenType KitchenType?

  /// Cuisine/theme tags shown on the profile (e.g. "North Indian", "Home-style").
  specialities String[] @default([])
  /// Max concurrent orders this kitchen can comfortably handle — optional, partner-set.
  capacity     Int?

  // Operations
  prepTimeMins      Int     @default(30)
  /// Legacy single-window hours — fallback when this kitchen has no `operatingHours`
  /// rows yet. `isKitchenOpenNow()` in `common/utils/kitchen.ts` prefers the rows.
  opensAt           String  @default("08:00") // HH:mm, IST
  closesAt          String  @default("22:00")
  /// The partner's own on/off switch — doubles as "emergency close" for today.
  isAcceptingOrders Boolean @default(true)
  contactPhone      String?

  ownerId String?
  owner   User?   @relation("KitchenOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// The partner login that manages this kitchen.
  accountId String?         @unique
  account   KitchenAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals     Meal[]
  media     KitchenMedia[]
  reels     Reel[]
  stories   KitchenStory[]
  reviews   Review[]
  orders    Order[]
  followers KitchenFollow[]

  operatingHours      KitchenOperatingHours[]
  holidayOverrides    KitchenHolidayOverride[]
  reelCampaigns       ReelCampaign[]
  subscriptions       Subscription[]
  subscriptionPlans   SubscriptionPlan[]
  wallet              KitchenWallet?
  premiumSubscription KitchenPremiumSubscription?
  campaignSuggestions CampaignSuggestion[]

  @@index([status, city])
  @@index([isVerified])
  @@map("kitchens")
}

/// Phase-1 lightweight gallery ("Fresh made today" photos / short clips).
model KitchenMedia {
  id           String    @id @default(uuid())
  kitchenId    String
  kitchen      Kitchen   @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  type         MediaType @default(IMAGE)
  url          String
  thumbnailUrl String?
  caption      String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([kitchenId, sortOrder])
  @@map("kitchen_media")
}

model KitchenFollow {
  id        String   @id @default(uuid())
  userId    String
  kitchenId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchen   Kitchen  @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, kitchenId])
  @@index([kitchenId])
  @@map("kitchen_follows")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// One row per day of the week — the rich replacement for `Kitchen.opensAt`/
/// `closesAt`. A kitchen with zero rows here still works: `isKitchenOpenNow()`
/// falls back to the legacy single-window fields until a partner sets these up
/// (lazily backfilled on first read of `GET /partner/operating-hours`).
model KitchenOperatingHours {
  id        String    @id @default(uuid())
  kitchenId String
  kitchen   Kitchen   @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  isClosed  Boolean   @default(false)

  // Two sessions per day (e.g. lunch/dinner) — both optional, both-or-neither.
  session1Start String? // "HH:mm", IST
  session1End   String?
  session2Start String?
  session2End   String?

  updatedAt DateTime @updatedAt

  @@unique([kitchenId, dayOfWeek])
  @@map("kitchen_operating_hours")
}

/// A specific calendar date that overrides the regular weekly schedule —
/// either fully closed (a holiday) or open with different hours than usual.
/// Takes precedence over `KitchenOperatingHours` when present for today.
model KitchenHolidayOverride {
  id        String   @id @default(uuid())
  kitchenId String
  kitchen   Kitchen  @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  isClosed  Boolean  @default(true)

  // Only meaningful when isClosed = false.
  session1Start String?
  session1End   String?
  session2Start String?
  session2End   String?

  note      String?
  createdAt DateTime @default(now())

  @@unique([kitchenId, date])
  @@index([kitchenId, date])
  @@map("kitchen_holiday_overrides")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEAL CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model MealCategory {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  iconUrl   String?
  slot      MealSlot?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  meals Meal[]

  @@map("meal_categories")
}

model Meal {
  id         String        @id @default(uuid())
  kitchenId  String
  kitchen    Kitchen       @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  categoryId String?
  category   MealCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Style of food (Thali, Biryani…) — drives the Home pills and carousel.
  cuisineId  String?
  cuisine    Cuisine?      @relation(fields: [cuisineId], references: [id], onDelete: SetNull)

  name        String
  slug        String
  description String?
  images      String[] @default([])

  price        Int // paise-free: whole rupees
  mrp          Int? // strike-through price
  isAvailable  Boolean @default(true)
  isBestseller Boolean @default(false)

  foodType        FoodType   @default(VEG)
  /// Can be prepared Jain-style (no onion/garlic/root veg) — a prep attribute
  /// of a veg dish, not a mutually-exclusive category, so it sits alongside
  /// `foodType` rather than as a 5th enum value. Only valid when foodType is
  /// VEG or VEGAN (enforced in the DTO, not the DB).
  isJainAvailable Boolean    @default(false)
  slots           MealSlot[] @default([])
  goalTags        GoalTag[]  @default([])

  // ── Nutrition transparency (per serving) ───────────────────────────────
  calories    Int?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  fiberG      Float?
  servingSize String? // e.g. "450 g bowl"
  ingredients String[] @default([])
  allergens   String[] @default([])

  prepTimeMins Int   @default(25)
  rating       Float @default(0)
  ratingCount  Int   @default(0)
  orderCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customizationGroups    MealCustomizationGroup[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  reviews                Review[]
  reels                  Reel[]
  stories                KitchenStory[]
  favorites              Favorite[]
  subscriptionDeliveries SubscriptionDelivery[]

  @@unique([kitchenId, slug])
  @@index([isAvailable, kitchenId])
  @@index([categoryId])
  @@index([cuisineId])
  @@map("meals")
}

/// e.g. "Add-ons" → Extra Butter +₹30 / Gulab Jamun +₹45 / Raita +₹25
model MealCustomizationGroup {
  id         String  @id @default(uuid())
  mealId     String
  meal       Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name       String
  isRequired Boolean @default(false)
  minSelect  Int     @default(0)
  maxSelect  Int     @default(5)
  sortOrder  Int     @default(0)

  options MealCustomizationOption[]

  @@index([mealId])
  @@map("meal_customization_groups")
}

model MealCustomizationOption {
  id          String                 @id @default(uuid())
  groupId     String
  group       MealCustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Int                    @default(0)
  isDefault   Boolean                @default(false)
  isAvailable Boolean                @default(true)
  sortOrder   Int                    @default(0)

  @@index([groupId])
  @@map("meal_customization_options")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  mealId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mealId])
  @@map("favorites")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────────────────────────────────────

model Address {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         AddressLabel @default(HOME)
  customLabel   String?
  receiverName  String?
  receiverPhone String?
  line1         String
  line2         String?
  landmark      String?
  locality      String?
  city          String       @default("Jaipur")
  state         String       @default("Rajasthan")
  pincode       String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]
  subscriptions Subscription[]

  @@index([userId, isDefault])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode    String?
  coinsToRedeem Int      @default(0)
  /// Set when the most recent add-to-cart came from tapping a shoppable Kitchen
  /// Story — copied onto the Order at placement time for attribution. Plain
  /// string, not a hard FK, same as couponCode: the story can expire/be
  /// deleted without orphaning the cart.
  sourceStoryId String?
  /// Same idea as sourceStoryId, for a shoppable Reel.
  sourceReelId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                  String   @id @default(uuid())
  cartId              String
  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  mealId              String
  meal                Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  quantity            Int      @default(1)
  /// Snapshot of chosen option ids — validated against the meal on every read.
  customizationIds    String[] @default([])
  specialInstructions String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([cartId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────────────────────────────────────────

model Coupon {
  id            String     @id @default(uuid())
  code          String     @unique
  title         String
  description   String?
  type          CouponType @default(FLAT)
  value         Int // rupees for FLAT, percent for PERCENT
  minOrderValue Int        @default(0)
  maxDiscount   Int? // caps PERCENT coupons
  validFrom     DateTime   @default(now())
  validTill     DateTime
  usageLimit    Int? // total redemptions allowed
  perUserLimit  Int        @default(1)
  usedCount     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  @@index([isActive, validTill])
  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────────────────────

model DeliveryPartner {
  id            String   @id @default(uuid())
  name          String
  phone         String
  photoUrl      String?
  vehicleNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  orders Order[]

  @@map("delivery_partners")
}

model Order {
  id          String  @id @default(uuid())
  orderNumber String  @unique // e.g. FB-92834
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchenId   String
  kitchen     Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Restrict)

  addressId       String?
  address         Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  /// Frozen copy of the address at placement time — addresses can be edited later.
  addressSnapshot Json

  status OrderStatus @default(PENDING_PAYMENT)

  // ── Money (whole rupees) ───────────────────────────────────────────────
  itemsTotal    Int
  deliveryFee   Int     @default(0)
  taxes         Int     @default(0)
  /// Combined coupon + coin discount. The coin share is `coinsRedeemed` (1 coin = ₹1).
  discount      Int     @default(0)
  totalAmount   Int
  couponCode    String?
  coinsRedeemed Int     @default(0)
  /// Frozen from Cart.sourceStoryId at placement — powers "orders from this story" on the partner dashboard.
  sourceStoryId String?
  /// Frozen from Cart.sourceReelId at placement — powers "orders from this reel" on the partner dashboard.
  sourceReelId  String?

  paymentMethod PaymentMethod @default(UPI)
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?

  slotType     DeliverySlotType @default(NOW)
  scheduledFor DateTime?
  orderNotes   String?

  etaMinutes   Int       @default(30)
  placedAt     DateTime?
  acceptedAt   DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  events   OrderStatusEvent[]
  reviews  Review[]
  messages OrderMessage[]

  @@index([userId, createdAt])
  @@index([kitchenId, status])
  @@map("orders")
}

model OrderItem {
  id      String  @id @default(uuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mealId  String?
  meal    Meal?   @relation(fields: [mealId], references: [id], onDelete: SetNull)

  // Snapshots — a meal can be renamed, repriced or deleted after the order.
  name                String
  imageUrl            String?
  unitPrice           Int
  quantity            Int
  customizations      Json    @default("[]")
  lineTotal           Int
  specialInstructions String?

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDER CHAT — per-order kitchen↔customer messaging
// ─────────────────────────────────────────────────────────────────────────────

enum ChatSenderType {
  KITCHEN
  CUSTOMER
}

model OrderMessage {
  id      String         @id @default(uuid())
  orderId String
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender  ChatSenderType
  body    String

  /// Set only when this message was sent alongside a real status transition
  /// (currently just the kitchen's "Out for delivery" quick-reply chip) —
  /// the other quick replies have no matching OrderStatus value.
  triggeredStatus OrderStatus?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchenId String
  kitchen   Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  mealId    String?
  meal      Meal?   @relation(fields: [mealId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  rating     Int // 1..5
  comment    String?
  photos     String[] @default([])
  /// Quick chips: "Clean", "Well-packed", "Eco-friendly"
  tags       String[] @default([])
  isVerified Boolean  @default(false)
  likeCount  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  helpfulVotes ReviewHelpfulVote[]

  @@unique([orderId, userId])
  @@index([kitchenId, createdAt])
  @@index([mealId, createdAt])
  @@map("reviews")
}

/// One row per (review, user) — lets a "helpful" tap be a real toggle instead
/// of an unbounded counter anyone can spam.
model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([userId])
  @@map("review_helpful_votes")
}

// ─────────────────────────────────────────────────────────────────────────────
// REELS / FOOD FEED
// ─────────────────────────────────────────────────────────────────────────────

model Reel {
  id        String  @id @default(uuid())
  kitchenId String
  kitchen   Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  /// Optional shoppable link — powers the "Add to cart" CTA on a reel.
  mealId    String?
  meal      Meal?   @relation(fields: [mealId], references: [id], onDelete: SetNull)

  videoUrl     String
  thumbnailUrl String?
  caption      String?
  hashtags     String[]   @default([])
  durationSec  Int        @default(0)
  status       ReelStatus @default(PUBLISHED)
  /// Temporarily hidden from the feed, resumable — distinct from ARCHIVED
  /// (permanent, one-way). A paused reel keeps its stats and can go live again.
  isPaused     Boolean    @default(false)
  /// Ops-set promotional flag — no self-serve boost flow or spend tracking yet.
  isSponsored  Boolean    @default(false)

  viewCount    Int @default(0)
  likeCount    Int @default(0)
  shareCount   Int @default(0)
  commentCount Int @default(0)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes     ReelLike[]
  saves     ReelSave[]
  campaigns ReelCampaign[]

  @@index([status, publishedAt])
  @@index([kitchenId])
  @@map("reels")
}

model ReelLike {
  id        String   @id @default(uuid())
  reelId    String
  userId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reelId, userId])
  @@index([userId])
  @@map("reel_likes")
}

model ReelSave {
  id        String   @id @default(uuid())
  reelId    String
  userId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reelId, userId])
  @@index([userId])
  @@map("reel_saves")
}

// ─────────────────────────────────────────────────────────────────────────────
// REEL ADVERTISING — self-serve, budget-based reel promotion
//
// Independent of `Reel.isSponsored` (an ops-only, no-spend flag from an
// earlier round) — this is the partner-facing "pay to promote" concept.
// No background jobs exist in this codebase, so spend is never accrued by a
// cron; it's computed on every read from `accrualAnchor`/`accruedSpendRs`,
// the same lazy-settlement idiom KitchenOperatingHours already uses.
// ─────────────────────────────────────────────────────────────────────────────

enum ReelCampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

model ReelCampaign {
  id            String             @id @default(uuid())
  kitchenId     String
  kitchen       Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  reelId        String
  reel          Reel               @relation(fields: [reelId], references: [id], onDelete: Cascade)
  dailyBudgetRs Int
  /// Mandatory for every campaign created from Round 5 on — endDate is
  /// server-computed from this (today + durationDays - 1) at creation, no
  /// longer client-supplied. Nullable in the DB only so pre-Round-5 rows
  /// (created before this field existed) don't need a migration backfill.
  durationDays  Int?
  /// Null = a pre-Round-5 indefinite campaign (legacy). Every new campaign gets one.
  endDate       DateTime?          @db.Date
  status        ReelCampaignStatus @default(ACTIVE)

  /// IST calendar date this campaign's spend has been settled up to.
  accrualAnchor  DateTime @db.Date
  /// Spend folded in from before `accrualAnchor` — the running total is
  /// `accruedSpendRs` + (days elapsed since the anchor, if still ACTIVE) × `dailyBudgetRs`.
  accruedSpendRs Int      @default(0)

  pausedAt  DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dailyStats         ReelCampaignDailyStat[]
  CampaignSuggestion CampaignSuggestion[]

  @@index([kitchenId, status])
  @@index([reelId, status])
  @@map("reel_campaigns")
}

/// One row per (campaign, IST calendar date) — impressions/clicks tracked
/// as a reel is served/viewed while a campaign on it is ACTIVE.
model ReelCampaignDailyStat {
  id          String       @id @default(uuid())
  campaignId  String
  campaign    ReelCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  impressions Int          @default(0)
  clicks      Int          @default(0)
  updatedAt   DateTime     @updatedAt

  @@unique([campaignId, date])
  @@map("reel_campaign_daily_stats")
}

// ─────────────────────────────────────────────────────────────────────────────
// WALLET — single unified ledger backing ad-boost charges and premium-plan
// charges (and, later, anything else that costs the kitchen money). No
// payment gateway is wired — top-up completes synchronously as PAID, same
// placeholder philosophy as FssaiAssistanceRequest.paymentStatus/Payout.
// ─────────────────────────────────────────────────────────────────────────────

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionReason {
  TOPUP
  AD_BOOST
  PREMIUM_PLAN
}

model KitchenWallet {
  id        String   @id @default(uuid())
  kitchenId String   @unique
  kitchen   Kitchen  @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  balanceRs Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("kitchen_wallets")
}

/// CREDIT (TOPUP) and DEBIT (AD_BOOST, PREMIUM_PLAN) share one table so
/// "Recent Transactions" is a single chronological read, not a merge across
/// feature tables the way Payouts' transaction list is.
model WalletTransaction {
  id          String                  @id @default(uuid())
  walletId    String
  wallet      KitchenWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        WalletTransactionType
  reason      WalletTransactionReason
  amountRs    Int
  description String
  /// The campaign/subscription this charge is for, when applicable — no
  /// enforced FK, so the referenced row can later be deleted without
  /// orphaning ledger history.
  referenceId String?
  createdAt   DateTime                @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI OPTIMIZATION SUGGESTIONS — one-shot Gemini structured-output calls over
// a kitchen's real campaign performance, capped to one batch/kitchen/day (no
// rate-limit/cache infra exists in this codebase — this batchDate check IS
// the rate limit).
// ─────────────────────────────────────────────────────────────────────────────

enum SuggestionType {
  /// Mechanical apply: bumps the target campaign's dailyBudgetRs, charges the wallet the delta.
  BUDGET_INCREASE
  /// Mechanical apply: adjusts Kitchen.serviceRadiusKm (clamped 1-40km), free.
  DELIVERY_RADIUS
  /// Acknowledge-only — changing a kitchen's public cuisine identity is too high-stakes for a one-tap AI apply.
  TARGET_CUISINE
  /// Acknowledge-only — no in-app video/creative editing exists to act on this automatically.
  CREATIVE_REFRESH
}

enum SuggestionStatus {
  NEW
  APPLIED
  DISMISSED
}

model CampaignSuggestion {
  id             String           @id @default(uuid())
  kitchenId      String
  kitchen        Kitchen          @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  /// Null for kitchen-wide suggestions (DELIVERY_RADIUS, TARGET_CUISINE) — set for campaign-scoped ones.
  campaignId     String?
  campaign       ReelCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type           SuggestionType
  title          String
  description    String
  /// {reachDeltaPct?, ordersDeltaPct?, roiDeltaPct?, expectedOrders?, costRs, effort} — AI-authored, shape kept loose on purpose.
  impact         Json
  /// The AI's own explanation for why it suggested this — shown verbatim as "AI Reasoning".
  reasoning      String
  status         SuggestionStatus @default(NEW)
  /// {field, before, after} once applied — null until then.
  appliedChanges Json?
  /// IST calendar date this batch was generated on — caps Gemini calls to once/kitchen/day.
  batchDate      DateTime         @db.Date
  appliedAt      DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime         @default(now())

  @@index([kitchenId, status])
  @@index([kitchenId, batchDate])
  @@map("campaign_suggestions")
}

// ─────────────────────────────────────────────────────────────────────────────
// SETTINGS / SUPPORT
// ─────────────────────────────────────────────────────────────────────────────

model NotificationPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderUpdates           Boolean  @default(true)
  promotions             Boolean  @default(true)
  newKitchens            Boolean  @default(true)
  reelActivity           Boolean  @default(false)
  whatsappUpdates        Boolean  @default(true)
  /// "Get notified before your next subscription cycle begins."
  subscriptionReminders  Boolean  @default(true)
  /// "Personalized meal suggestions based on your taste profile."
  dailyAiRecommendations Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  @@map("notification_preferences")
}

model FaqItem {
  id        String  @id @default(uuid())
  category  String  @default("GENERAL")
  question  String
  answer    String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@index([isActive, category, sortOrder])
  @@map("faq_items")
}

// ═════════════════════════════════════════════════════════════════════════════
// KITCHEN PARTNER ACCOUNTS
//
// Deliberately a separate identity from `User`. A phone number can belong to a
// customer *and* to a kitchen partner — the same person may order lunch and run
// a kitchen — and a single `User.role` column cannot express that. Two tables,
// two OTP flows, two JWT audiences, enforced by `KitchenJwtStrategy`.
// ═════════════════════════════════════════════════════════════════════════════

enum KitchenAccountStatus {
  /// Phone not yet verified.
  PENDING_VERIFICATION
  /// Verified, still filling in the onboarding steps.
  ONBOARDING
  /// Application submitted, waiting on the FreshBhoj team.
  UNDER_REVIEW
  /// Approved — the kitchen is live and can take orders.
  ACTIVE
  REJECTED
  SUSPENDED
  /// Self-deleted by the partner. The Kitchen storefront (if any) is paused,
  /// not erased — historical orders/reviews need it to stay resolvable.
  DELETED
}

/// Ordered onboarding funnel. `KitchenAccount.onboardingStep` is the furthest
/// step completed, so the partner app can always resume where they left off.
enum KitchenOnboardingStep {
  PHONE_VERIFIED
  OWNER_DETAILS
  KITCHEN_DETAILS
  LOCATION
  DOCUMENTS
  BANK_DETAILS
  MENU_SETUP
  SUBMITTED
  COMPLETED
}

enum KitchenDocumentType {
  FSSAI
  GST
  PAN
  AADHAAR
  SHOP_LICENSE
  BANK_PROOF
  /// Unused — superseded by KITCHEN_PHOTO_FRONT / KITCHEN_PHOTO_MAIN, kept so
  /// existing rows (if any) don't break. Do not write new rows with this type.
  KITCHEN_PHOTOS
  KITCHEN_PHOTO_FRONT
  KITCHEN_PHOTO_MAIN
}

/// Business format the partner registers as, chosen during onboarding.
enum KitchenType {
  HOME_KITCHEN
  CLOUD_KITCHEN
  RESTAURANT
  TIFFIN_SERVICE
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model KitchenAccount {
  id              String                @id @default(uuid())
  phone           String                @unique
  email           String?               @unique
  ownerName       String?
  isPhoneVerified Boolean               @default(false)
  status          KitchenAccountStatus  @default(PENDING_VERIFICATION)
  onboardingStep  KitchenOnboardingStep @default(PHONE_VERIFIED)

  /// Set when the team rejects an application, shown verbatim in the partner app.
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  lastLoginAt     DateTime?
  fcmToken        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kitchen                 Kitchen?
  refreshTokens           KitchenRefreshToken[]
  documents               KitchenDocument[]
  bankAccount             KitchenBankAccount?
  fssaiAssistanceRequests FssaiAssistanceRequest[]
  notifications           Notification[]
  payouts                 Payout[]
  bhojAiConversations     BhojAiConversation[]
  bhojAiEscalations       BhojAiEscalation[]

  @@index([status])
  @@map("kitchen_accounts")
}

model KitchenRefreshToken {
  id         String         @id @default(uuid())
  token      String         @unique // hashed
  accountId  String
  account    KitchenAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceInfo String?
  isRevoked  Boolean        @default(false)
  expiresAt  DateTime
  createdAt  DateTime       @default(now())

  @@index([accountId])
  @@map("kitchen_refresh_tokens")
}

model KitchenDocument {
  id        String              @id @default(uuid())
  accountId String
  account   KitchenAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      KitchenDocumentType
  /// Licence / GSTIN / PAN number as typed by the partner.
  number    String?
  fileUrl   String
  status    DocumentStatus      @default(PENDING)
  remarks   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([accountId, type])
  @@map("kitchen_documents")
}

/// A partner who doesn't already have an FSSAI licence can ask FreshBhoj's
/// ops team to file the government application on their behalf, for a fee.
/// Deliberately independent of `KitchenAccount.onboardingStep` (forward-only
/// funnel) and `KitchenDocument` (one row per type, ever) — this can be
/// requested at any point, and a rejected/cancelled request can be followed
/// by a fresh one.
enum FssaiAssistanceStatus {
  PENDING_PAYMENT
  DOCUMENTS_SUBMITTED
  APPLICATION_FILED
  GOVT_REVIEW_IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

model FssaiAssistanceRequest {
  id        String                @id @default(uuid())
  accountId String
  account   KitchenAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status    FssaiAssistanceStatus @default(PENDING_PAYMENT)

  govtFee    Int @default(1000)
  serviceFee Int @default(500)
  totalFee   Int @default(1500)

  /// Placeholder for this phase — no payment gateway is wired yet.
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?

  licenseNumber  String?
  validFrom      DateTime?
  validTill      DateTime?
  certificateUrl String?

  rejectionReason String?
  submittedAt     DateTime?
  filedAt         DateTime?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents FssaiAssistanceDocument[]

  @@index([accountId])
  @@index([status])
  @@map("fssai_assistance_requests")
}

enum FssaiAssistanceDocumentType {
  IDENTITY_PROOF
  ADDRESS_PROOF
  KITCHEN_PHOTO
  PASSPORT_PHOTO
}

model FssaiAssistanceDocument {
  id        String                      @id @default(uuid())
  requestId String
  request   FssaiAssistanceRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      FssaiAssistanceDocumentType
  fileUrl   String
  status    DocumentStatus              @default(PENDING)
  remarks   String?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  // Unique per REQUEST, not per account — a fresh request after a rejected
  // one starts with a clean document set.
  @@unique([requestId, type])
  @@map("fssai_assistance_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// BHOJAI — the kitchen partner's AI assistant (multi-turn, tool-calling)
// ─────────────────────────────────────────────────────────────────────────────

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

/// One conversation per account at a time — `/bhojai/reset` archives the
/// current one so the next message starts fresh.
model BhojAiConversation {
  id        String             @id @default(uuid())
  accountId String
  account   KitchenAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  messages    BhojAiMessage[]
  escalations BhojAiEscalation[]

  @@index([accountId, status])
  @@map("bhojai_conversations")
}

enum BhojAiMessageRole {
  USER
  MODEL
  FUNCTION
}

model BhojAiMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   BhojAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           BhojAiMessageRole

  /// Prose — the user's text, or the model's final answer. Null on
  /// functionCall/FUNCTION rows (those are internal bookkeeping, never shown).
  text           String?
  /// {name, args} — set on MODEL rows that requested a tool instead of answering.
  functionCall   Json?
  /// {name, response} — set on FUNCTION rows: our tool's return value, fed
  /// back to Gemini as the next turn.
  functionResult Json?
  /// Deterministic, backend-built UI payload (e.g. a status card) attached to
  /// a final MODEL text row — never authored by the model itself.
  card           Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("bhojai_messages")
}

enum EscalationStatus {
  OPEN
  RESOLVED
}

/// What the `requestHumanEscalation` tool creates — a ticket ops can see via
/// the V0 admin tool. No paging/human notification exists; this is the whole
/// scope of "escalate to a specialist" for now.
model BhojAiEscalation {
  id             String              @id @default(uuid())
  accountId      String
  account        KitchenAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   BhojAiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reason         String
  status         EscalationStatus    @default(OPEN)
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
  @@map("bhojai_escalations")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS (kitchen-partner in-app feed)
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationCategory {
  ORDER
  SUBSCRIPTION
  REEL
  GENERAL
}

/// SUBSCRIPTION/REEL exist for UI completeness (the mockup's tab set) but have
/// zero producers right now — no subscriptions feature and no reel-engagement
/// event pipeline exist yet. Same scope reduction as the unused
/// NotificationPreference.promotions/newKitchens toggles.
model Notification {
  id        String               @id @default(uuid())
  accountId String
  account   KitchenAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  title     String
  body      String
  /// e.g. {"orderId": "...", "action": "ACCEPT_ORDER"} — drives inline quick-actions.
  data      Json?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([accountId, isRead, createdAt])
  @@index([accountId, category, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYOUTS
// ─────────────────────────────────────────────────────────────────────────────

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id        String         @id @default(uuid())
  accountId String
  account   KitchenAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount    Int
  status    PayoutStatus   @default(REQUESTED)

  /// Snapshot of KitchenBankAccount at request time — the destination can
  /// change later without altering a payout already in flight.
  bankAccountSnapshot Json

  /// Placeholder — no real transfer/gateway API wired, mirrors
  /// FssaiAssistanceRequest.paymentRef.
  transferRef   String?
  failureReason String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  paidAt      DateTime?

  @@index([accountId, status])
  @@map("payouts")
}

model KitchenBankAccount {
  id                 String         @id @default(uuid())
  accountId          String         @unique
  account            KitchenAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountHolderName  String
  /// Only the last 4 digits are retained; the full number never touches our DB.
  accountNumberLast4 String
  ifsc               String
  bankName           String?
  upiId              String?
  isVerified         Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("kitchen_bank_accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBSCRIPTIONS — recurring meal plans, kitchen-managed
//
// No background-job infra exists in this codebase, so delivery/billing rows
// are never generated by a cron. They're lazily backfilled on read (and once
// eagerly on approval), the same idiom as KitchenOperatingHours's 7-day
// backfill and ReelCampaign's spend settlement.
// ─────────────────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  /// Customer has requested it; the kitchen hasn't approved or rejected yet.
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  REJECTED
}

enum SubscriptionBillingCycle {
  WEEKLY
  MONTHLY
}

enum DeliveryScheduleStatus {
  SCHEDULED
  DISPATCHED
  SKIPPED
}

model Subscription {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchenId String
  kitchen   Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  planName            String
  foodType            FoodType
  mealsPerDay         Int                      @default(1)
  deliveryDays        DayOfWeek[]
  deliveryTime        MealSlot
  billingCycle        SubscriptionBillingCycle @default(WEEKLY)
  /// Frozen at creation — later price-list changes don't affect an existing subscriber.
  pricePerCycle       Int
  specialInstructions String?

  /// Set when this request was created from a kitchen-authored SubscriptionPlan
  /// (see below) rather than a customer's bespoke free-form request. Nullable —
  /// every subscription created before this field existed, and every future
  /// bespoke request, has no plan.
  planId String?
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id])

  /// Only meaningful for a bespoke (no planId) request — the customer's chosen
  /// delivery address and payment method. Nullable: every plan-based request
  /// and every pre-existing row created before these fields existed has none.
  addressId       String?
  address         Address?      @relation(fields: [addressId], references: [id])
  /// Frozen copy of the address text at subscribe time, same reasoning as
  /// pricePerCycle — a later address edit/delete shouldn't rewrite history.
  addressSnapshot Json?
  paymentMethod   PaymentMethod @default(UPI)
  /// FreshBhoj Coins redeemed against the first billing cycle (1 coin = ₹1),
  /// only ever non-zero when paymentMethod is WALLET — refunded on reject.
  coinsRedeemed   Int           @default(0)

  status          SubscriptionStatus @default(PENDING)
  rejectionReason String?

  startDate   DateTime  @db.Date
  approvedAt  DateTime?
  pausedAt    DateTime?
  /// Set only by a customer-initiated timed pause (vacation mode) — when this
  /// date has passed, the next read auto-resumes the subscription. A kitchen's
  /// indefinite pause (or a customer's own indefinite pause) leaves this null.
  pausedUntil DateTime? @db.Date
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries    SubscriptionDelivery[]
  billingEvents SubscriptionBillingEvent[]

  @@index([kitchenId, status])
  @@index([userId])
  @@map("subscriptions")
}

/// A kitchen-authored, reusable subscription plan template (e.g. "Weekly
/// Plan" — fixed price, day count, and a menu of diet/delivery-slot options
/// the customer picks from) that customers browse on the kitchen's public
/// profile and subscribe to. Distinct from a bespoke `Subscription` request:
/// a plan is the kitchen's own published offer, not any one customer's ask.
/// Subscribing still creates a normal PENDING `Subscription` row (via
/// `planId` above) that goes through the exact same approve/reject flow —
/// this model only supplies the template, it never bypasses that gate.
model SubscriptionPlan {
  id        String  @id @default(uuid())
  kitchenId String
  kitchen   Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  name                String
  billingCycle        SubscriptionBillingCycle
  deliveryDays        DayOfWeek[]
  mealsPerDay         Int                      @default(1)
  /// The actual, discounted price customers pay. `originalPriceRs`, when set
  /// and higher, drives the mockup's struck-through MRP + discount badge.
  priceRs             Int
  originalPriceRs     Int?
  /// Which FoodType choices this plan offers — the customer picks one at
  /// subscribe time, constrained to this list.
  dietOptions         FoodType[]
  jainAvailable       Boolean                  @default(false)
  /// Which delivery-time choices this plan offers — same idea as dietOptions.
  slotOptions         MealSlot[]
  includesDescription String
  isPopular           Boolean                  @default(false)
  /// Soft-hide only — no delete endpoint, so a plan with existing subscribers
  /// can be retired from the public browse list without breaking their FK.
  isActive            Boolean                  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([kitchenId, isActive])
  @@map("subscription_plans")
}

/// One row per (subscription, delivery date) — a rolling 7-day window is
/// lazily backfilled on every `GET /partner/subscriptions/:id` while ACTIVE.
model SubscriptionDelivery {
  id             String                 @id @default(uuid())
  subscriptionId String
  subscription   Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  date           DateTime               @db.Date
  status         DeliveryScheduleStatus @default(SCHEDULED)
  dispatchedAt   DateTime?
  skipReason     String?
  /// Which specific dish is scheduled for this delivery — set by the
  /// customer's own "swap dish" action (see CustomerSubscriptionsService).
  /// Null means "kitchen's choice / not yet swapped."
  mealId         String?
  meal           Meal?                  @relation(fields: [mealId], references: [id])
  createdAt      DateTime               @default(now())

  @@unique([subscriptionId, date])
  @@map("subscription_deliveries")
}

/// One row per billing-cycle boundary already in the past — always created
/// already-PAID (a placeholder charge, no payment gateway wired, same as
/// FssaiAssistanceRequest/Payout in earlier rounds).
model SubscriptionBillingEvent {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cycleStart     DateTime      @db.Date
  amount         Int
  paymentStatus  PaymentStatus @default(PAID)
  createdAt      DateTime      @default(now())

  @@unique([subscriptionId, cycleStart])
  @@map("subscription_billing_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER WALLET — a real prepaid balance for the customer app, structurally
// identical to KitchenWallet/WalletTransaction above but a completely separate
// model family (different owner, different reasons) — deliberately NOT the
// same table as the kitchen wallet, and deliberately NOT merged with the
// existing User.coinsBalance/CoinTransaction system (coins are earned-only
// loyalty currency spent as an order discount; this is real rupees the
// customer can add and withdraw).
// ─────────────────────────────────────────────────────────────────────────────

enum CustomerWalletTransactionType {
  CREDIT
  DEBIT
}

enum CustomerWalletTransactionReason {
  TOPUP
  ORDER_PAYMENT
  SUBSCRIPTION_PAYMENT
  WITHDRAWAL
  REFUND
}

model CustomerWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceRs Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CustomerWalletTransaction[]
  withdrawals  CustomerWalletWithdrawal[]

  @@map("customer_wallets")
}

model CustomerWalletTransaction {
  id          String                          @id @default(uuid())
  walletId    String
  wallet      CustomerWallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        CustomerWalletTransactionType
  reason      CustomerWalletTransactionReason
  amountRs    Int
  description String
  /// The order/subscription/withdrawal this entry is for, when applicable —
  /// no enforced FK, same reasoning as WalletTransaction.referenceId.
  referenceId String?
  createdAt   DateTime                        @default(now())

  @@index([walletId, createdAt])
  @@map("customer_wallet_transactions")
}

enum CustomerWalletWithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

/// Mirrors Payout exactly (REQUESTED → PROCESSING → PAID/FAILED, advanced by
/// hand via an ops admin tool, never a gateway) — the balance is debited
/// immediately at request time (reserves the funds so a customer can't
/// request more than they have twice over) and refunded via a CustomerWallet
/// REFUND transaction if an ops admin marks it FAILED.
model CustomerWalletWithdrawal {
  id       String                         @id @default(uuid())
  walletId String
  wallet   CustomerWallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amountRs Int
  status   CustomerWalletWithdrawalStatus @default(REQUESTED)

  /// Ad-hoc UPI ID / bank details typed once per request — no persistent
  /// saved-payout-destination entity exists for customers (unlike
  /// KitchenBankAccount), so this is captured as a snapshot per request.
  destination Json

  failureReason String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  paidAt      DateTime?

  @@index([walletId, status])
  @@map("customer_wallet_withdrawals")
}

// ─────────────────────────────────────────────────────────────────────────────
// PREMIUM PLANS — FreshBhoj selling a tier TO a kitchen. Deliberately
// distinct naming from Subscription/SubscriptionStatus (a customer's
// recurring meal plan with a kitchen) to avoid the collision. Renewal is
// lazy/computed-on-read on GET /partner/premium/subscription, same idiom as
// ReelCampaign settlement and Subscription billing backfill — no cron exists.
// ─────────────────────────────────────────────────────────────────────────────

enum PremiumTier {
  BASIC
  PRO
  ELITE
}

enum PremiumSubscriptionStatus {
  ACTIVE
  EXPIRED
}

model KitchenPremiumSubscription {
  id               String                    @id @default(uuid())
  kitchenId        String                    @unique
  kitchen          Kitchen                   @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  tier             PremiumTier
  status           PremiumSubscriptionStatus @default(ACTIVE)
  /// Frozen at purchase/renewal — a later price-list change doesn't affect an already-paid period.
  priceRs          Int
  currentPeriodEnd DateTime                  @db.Date
  autoRenew        Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@map("kitchen_premium_subscriptions")
}

// ═════════════════════════════════════════════════════════════════════════════
// CUISINES — the horizontal pills and the cover-flow carousel on Home
// ═════════════════════════════════════════════════════════════════════════════

/// Distinct from `MealCategory`: a category is a time slot (Breakfast, Lunch),
/// a cuisine is a style of food (Thali, Biryani, South Indian). Home shows both.
model Cuisine {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  /// Small circular icon for the pill row.
  iconUrl   String?
  /// Larger plate image for the cover-flow carousel.
  imageUrl  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  meals Meal[]

  @@index([isActive, sortOrder])
  @@map("cuisines")
}

// ═════════════════════════════════════════════════════════════════════════════
// KITCHEN STORIES — 24-hour ephemeral clips, scoped to the viewer's city
// ═════════════════════════════════════════════════════════════════════════════

model KitchenStory {
  id           String    @id @default(uuid())
  kitchenId    String
  kitchen      Kitchen   @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  mediaType    MediaType @default(VIDEO)
  mediaUrl     String
  thumbnailUrl String?
  caption      String?
  /// Optional shoppable link, same idea as a reel.
  mealId       String?
  meal         Meal?     @relation(fields: [mealId], references: [id], onDelete: SetNull)

  /// Denormalised from the kitchen so the city feed is a single indexed read.
  city        String
  durationSec Int      @default(15)
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  shareCount  Int      @default(0)
  isActive    Boolean  @default(true)
  /// Stories disappear after this instant. Set to +24h on publish.
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  views KitchenStoryView[]
  likes KitchenStoryLike[]

  @@index([city, isActive, expiresAt])
  @@index([kitchenId, expiresAt])
  @@map("kitchen_stories")
}

/// One row per (story, customer) like — mirrors ReviewHelpfulVote's toggle shape.
model KitchenStoryLike {
  id        String       @id @default(uuid())
  storyId   String
  story     KitchenStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([storyId, userId])
  @@index([userId])
  @@map("kitchen_story_likes")
}

/// Powers the seen/unseen ring around a story avatar.
model KitchenStoryView {
  id       String       @id @default(uuid())
  storyId  String
  userId   String
  story    KitchenStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime     @default(now())

  @@unique([storyId, userId])
  @@index([userId])
  @@map("kitchen_story_views")
}

// ═════════════════════════════════════════════════════════════════════════════
// SAVED PAYMENT METHODS
// ═════════════════════════════════════════════════════════════════════════════

enum CardBrand {
  VISA
  MASTERCARD
  RUPAY
  AMEX
  DINERS
  UNKNOWN
}

/// PCI note: we never store a card number, CVV or expiry-with-PAN. Only the
/// gateway's network token plus the display fragments needed to render the row.
model SavedCard {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand        CardBrand @default(UNKNOWN)
  last4        String
  expiryMonth  Int
  expiryYear   Int
  holderName   String?
  /// Opaque token issued by the payment gateway — the only thing that can charge.
  gatewayToken String
  gateway      String    @default("razorpay")
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, gatewayToken])
  @@index([userId, isDefault])
  @@map("saved_cards")
}

/// A customer-entered UPI VPA — stored as typed, same no-real-verification
/// placeholder idiom as everywhere else in this codebase (e.g. the customer
/// wallet withdrawal `destination` snapshot). Distinct from SavedCard, which
/// assumes a real gateway-tokenised flow (this app has no such SDK wired).
model UpiId {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpa       String
  label     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, vpa])
  @@index([userId, isDefault])
  @@map("upi_ids")
}
